# NyayaGraph-GN Backend Configuration
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
PROJECT_NAME="NyayaGraph-GN Detective Workbench"

# Host & Port
HOST=0.0.0.0
PORT=8000

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Storage & Paths
DATA_DIR="../data"
UPLOAD_DIR="./data/uploads"
OUTPUT_DIR="./data/outputs"

# DeepSeek AI API Configuration (RAG Legal Forensic Detective Copilot)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-flash"


# Blockchain & BSA 2023 Sec 63(4)
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
USE_LOCAL_LEDGER_FALLBACK=true
